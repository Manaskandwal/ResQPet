# ==========================================
# PawSaarthi Backend - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Cloudinary (free tier — for rescue media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (TEST MODE ONLY — leave blank to use mock payment)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Admin Seed (used by: npm run seed)
ADMIN_NAME=PawSaarthi Admin
ADMIN_EMAIL=admin@pawsaarthi.com
ADMIN_PASSWORD=Admin@123456

# Support / Refund disputes email
SUPPORT_EMAIL=pawsaarthi.support@gmail.com

# Frontend URL (for CORS — update to Vercel URL in production)
CLIENT_URL=http://localhost:5173

# Firebase Cloud Messaging (optional, for native push notifications)
FCM_SERVER_KEY=your_fcm_server_key

# NVIDIA AI Endpoint Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
AI_CHAT_DAILY_LIMIT=5
AI_CHAT_MINUTE_LIMIT=2
NVIDIA_MODEL_NAME=mistralai/mistral-nemotron
